{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:pages": "vite build --base=/medtrack/ && node -e \"const f=require('fs');f.copyFileSync('dist/index.html','dist/404.html');f.writeFileSync('dist/.nojekyll','')\"",
